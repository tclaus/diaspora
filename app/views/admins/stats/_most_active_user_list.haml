%table.table.table-striped
  %thead
    %tr
      %th{scope: "col"}
        Username
      %th{scope: "col"}
        Posts count
  %tbody
    - list.rows.each do |author_id, count|
      %tr
        %th{scope: "row"}
          = "#{Person.find(author_id).diaspora_handle}"
        %th
          = "#{count}"
